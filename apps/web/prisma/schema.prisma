// Ligem data model.
// Design decisions behind this schema are captured in project memory
// (ligem_positioning, ligem_roles_and_content_model, ligem_trust_legal_business,
// ligem_tech_and_design) and in ../../CLAUDE.md.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

// --- Auth (Auth.js / NextAuth-compatible shape) ---------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  // Profile picture — reused as-is from the Auth.js/PrismaAdapter default
  // shape (auto-populated from the provider's profile for Google sign-in).
  // For local uploads (see /mein-konto), this holds an `/api/media/<key>`
  // proxy path exactly like every other MinIO-backed image in this app,
  // not a raw storage key — so it can be used directly as an <img src>
  // regardless of whether it came from Google or from an upload.
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Updated on every successful sign-in (see auth.ts's `events.signIn`) —
  // deliberately just a single timestamp, not a full login-history log,
  // matching this app's otherwise lightweight trust/safety footprint.
  lastLoginAt   DateTime?
  // Opt-in toggle (see /mein-konto) — forwards a copy of every new
  // ContactRequest on any Listing this user owns/co-manages to this User's
  // own real `email`, via SMTP (src/lib/mailer.ts), since otherwise a
  // contact request only ever shows up inside the app itself (the
  // Kontaktanfragen page) with no notification at all.
  notifyContactRequestsByEmail Boolean @default(false)

  roles UserRoleAssignment[]

  accounts Account[]
  sessions Session[]

  ownedOrganizations Organization[]     @relation("OrganizationOwner")
  createdListings    Listing[]          @relation("ListingCreatedBy")
  moderatedListings  Listing[]          @relation("ListingModeratedBy")
  media              Media[]           @relation("MediaUploadedBy")
  createdEvents      Event[]            @relation("EventCreatedBy")
  savedSearches       SavedSearch[]
  reportsFiled        Report[]          @relation("ReportReporter")
  reportsReviewed     Report[]          @relation("ReportReviewedBy")
  contactRequestsSent ContactRequest[]  @relation("ContactRequestSender")
  appointmentsHosted  Appointment[]     @relation("AppointmentHost")
  appointmentsBooked  Appointment[]     @relation("AppointmentRequestedBy")
  eventRegistrations  EventRegistration[] @relation("EventRegistrationSender")
  // Listings this user co-manages on someone else's behalf — see
  // ListingManager below. Distinct from createdListings (the original
  // owner/creator), which always keeps full rights including managing
  // this list itself.
  listingManagerships ListingManager[]
  // Views this user contributed while logged in (see ListingView above) —
  // named, with a link to their account, in a listing's statistics view.
  listingViews        ListingView[]
  eventViews          EventView[]
  pageViews           PageView[]
}

// Grants a second (or third, ...) user edit rights on a Listing they didn't
// create — content-editing rights only (see canManageListing/canManageEvent
// in src/lib/authz.ts): a manager can edit the listing and its events, but
// cannot add/remove other managers — only the original creator
// (Listing.createdById) or an ADMIN can. A Listing's own events inherit
// this automatically (an Event with a listingId checks its listing's
// managers too), so there's no separate EventManager table — sharing a
// project also shares its calendar, per product decision. Managed from
// /mein-konto by the listing's original creator.
model ListingManager {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([listingId, userId])
}

enum UserRole {
  SUCHENDE
  ANBIETER
  MODERATOR
  ADMIN
}

// A user can hold several roles at once (e.g. Suchende + Anbieter simultaneously).
model UserRoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      UserRole
  createdAt DateTime @default(now())

  @@unique([userId, role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Organizations ---------------------------------------------------------

// Gemeinwohlorientierte Organisationen/Vereine/Genossenschaften - a first-class
// actor distinct from a plain User, can own several listings/locations.
model Organization {
  id          String   @id @default(cuid())
  name        String
  description String?
  website     String?
  ownerId     String
  owner       User     @relation("OrganizationOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listings Listing[]
  events   Event[]
}

// --- Listing taxonomy (freely extensible, DB-backed, no hardcoded enum) ---

model ListingCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  nameEn      String?
  description String?
  createdAt   DateTime @default(now())

  listings ListingCategoryAssignment[]
}

model ListingCategoryAssignment {
  listingId  String
  listing    Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  categoryId String
  category   ListingCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([listingId, categoryId])
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum ListingViewType {
  // Recorded once per PUBLISHED listing whenever it's rendered as a card in
  // the /projekte results list (see recordListingViews in src/lib/
  // listing-views.ts) — an "impression", not a click.
  OVERVIEW
  // Recorded once whenever the listing's full detail is actually opened,
  // either the standalone /projekte/[id] page or the inline ?projekt=<id>
  // pane on /projekte (both render the same ListingDetail component).
  DETAIL
}

// One row per listing view (see ListingViewType) for the "Meine Projekte"
// statistics feature. No session id, and — per explicit product decision —
// the raw client IP itself is never persisted either: only its two derived,
// less-identifying summaries (`hostname` via reverse DNS, `country` via a
// local GeoIP lookup, see src/lib/ip-lookup.ts) are stored, and neither on
// its own reconstructs the address. This still isn't nothing from a DSGVO
// standpoint — flag it for /datenschutz's eventual legal review alongside
// every other data point already listed there.
model ListingView {
  id           String          @id @default(cuid())
  listingId    String
  listing      Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  viewType     ListingViewType
  viewedAt     DateTime        @default(now())
  // Set only when the viewer was logged in at the time — shown by name
  // with a link to their profile in the statistics view (see
  // src/app/projekte/[id]/statistik/page.tsx). SetNull rather than Cascade:
  // deleting a user account shouldn't retroactively erase the historical
  // view counts they contributed.
  viewerId     String?
  viewer       User?           @relation(fields: [viewerId], references: [id], onDelete: SetNull)
  // Classified from the request's User-Agent header (src/lib/bot-detect.ts)
  // — known search engines/AI agents get a real name in botName (e.g.
  // "Googlebot", "GPTBot"); an unrecognized bot-like UA still sets isBot
  // with botName null ("Sonstiger Bot"); a normal browser leaves both at
  // their defaults.
  isBot        Boolean         @default(false)
  botName      String?
  // Hostname only (e.g. "www.google.com"), never the full referrer URL —
  // a full URL can carry another site's own query-string/path details that
  // have nothing to do with this app and aren't this app's to store.
  referrerHost String?
  // The *viewer's own* reverse-DNS hostname and GeoIP country (ISO code,
  // e.g. "DE") — both derived from the request's IP address at record
  // time via src/lib/ip-lookup.ts, which never stores the IP itself. Either
  // can be null: no PTR record for that IP, GeoIP has no match, or the IP
  // couldn't be determined at all (see getClientIp — requires the reverse
  // proxy to forward X-Forwarded-For, see DEPLOYMENT.md's Apache section;
  // absent entirely in local dev without a proxy in front of it).
  hostname     String?
  country      String?
  // The active `suche` keyword (lowercased, so "Garten"/"garten" aggregate
  // together) and a human-readable summary of every other active filter —
  // both only ever set for a view recorded while /projekte's search/filter
  // form actually produced this listing (OVERVIEW, or the DETAIL view
  // reached by clicking into the inline ?projekt= pane from that same
  // search); a standalone /projekte/[id] visit has no search context at
  // all, so both stay null there. `filtersSummary` reuses the exact same
  // `activeFilters` array /projekte/page.tsx already builds for its
  // "N Projekte gefunden für ..." results heading, joined with ", " —
  // rather than re-deriving filter option names from raw ids again here.
  searchTerm     String?
  filtersSummary String?

  @@index([listingId, viewType])
}

// Mirrors ListingViewType exactly, for the same statistics feature applied
// to Events instead of Listings (see EventView below) — kept as its own
// enum rather than reusing ListingViewType, matching how this app already
// keeps Listing/Event infrastructure as parallel-but-separate models
// throughout (ListingAttributeOption/EventAttributeOption, ListingCategory
// having no Event equivalent, etc.) rather than introducing a shared
// polymorphic abstraction for two content types with otherwise different
// permission/ownership shapes.
enum EventViewType {
  OVERVIEW
  DETAIL
}

// Mirrors ListingView exactly (see there for the full rationale — reverse-
// DNS hostname + GeoIP country instead of the raw IP itself, etc.) for
// Events instead of Listings. No `searchTerm` field here: /termine has no
// keyword-search field at all (only Zeitraum/Art/Zielgruppe/Umkreis),
// unlike /projekte's header keyword search.
model EventView {
  id             String        @id @default(cuid())
  eventId        String
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  viewType       EventViewType
  viewedAt       DateTime      @default(now())
  viewerId       String?
  viewer         User?         @relation(fields: [viewerId], references: [id], onDelete: SetNull)
  isBot          Boolean       @default(false)
  botName        String?
  referrerHost   String?
  hostname       String?
  country        String?
  // Human-readable summary of active Zeitraum/Art/Zielgruppe/Umkreis
  // filters at record time — see ListingView.filtersSummary, same rationale
  // and same reuse of /termine/page.tsx's own activeFilters array.
  filtersSummary String?

  @@index([eventId, viewType])
}

// Generic site-wide page-view tracker (src/middleware.ts) — every route
// EXCEPT /projekte* and /termine*, which already get the much more detailed
// ListingView/EventView tracking above and would otherwise be double-
// counted. Recorded from Middleware rather than per-page, since that's the
// only place in the App Router that sees every request without having to
// individually instrument every single page.tsx across the site. Same
// no-raw-IP shape as ListingView/EventView (see there for the rationale);
// no viewType (OVERVIEW/DETAIL only makes sense for the search-results/
// detail-pane distinction Listings/Events have) and no searchTerm/
// filtersSummary (no comparable concept on a generic page).
model PageView {
  id           String   @id @default(cuid())
  // Pathname only (e.g. "/hilfe/rollen"), never the query string — a page
  // like /mein-konto?fotos=1 is still the same "page" for this purpose.
  path         String
  viewedAt     DateTime @default(now())
  viewerId     String?
  viewer       User?    @relation(fields: [viewerId], references: [id], onDelete: SetNull)
  isBot        Boolean  @default(false)
  botName      String?
  referrerHost String?
  hostname     String?
  country      String?

  @@index([path])
}

// A Wohnprojekt/WG listing. Only projectName + owner are required. Structural
// fields needed for search/map/browsing (location, group size, cost,
// availability) are real columns; open-ended categorical filters (Projekt Typ,
// Grundwerte, Wohnlage, Zielgruppe, ...) go through the generic
// AttributeGroup/AttributeOption system below instead of one column each, so
// new filter values — or whole new filter groups — can be added as rows,
// without a migration.
model Listing {
  id        String        @id @default(cuid())
  status    ListingStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  publishedAt DateTime?

  // True for synthetic listings created by the /admin/demo-daten generator
  // (never set anywhere else) — lets the moderation queue flag them and
  // supports bulk-cleaning them back out again.
  isDemo Boolean @default(false)

  // Required
  projectName String
  createdById String
  createdBy   User   @relation("ListingCreatedBy", fields: [createdById], references: [id])
  motto       String? // kurzer Claim/Untertitel

  // Eigene Homepage des Projekts (URL). "http(s)://" wird beim Speichern
  // automatisch ergänzt, falls es fehlt (siehe src/lib/normalize-url.ts).
  // Grundlage für den KI-Import-Button im Formular (siehe
  // src/lib/homepage-import.ts): durchsucht diese Seite und füllt "So leben
  // wir", Kontaktdaten, Adresse und die Foto-Galerie automatisch aus.
  homepageUrl String?
  // Zeitpunkt des letzten KI-Imports — dient nur als einfache
  // Missbrauchsbremse (Cooldown), damit der Button nicht im Sekundentakt
  // wiederholte, kostenpflichtige LLM-Aufrufe auslösen kann.
  lastAiImportAt DateTime?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  moderatedById String?
  moderatedBy   User?   @relation("ListingModeratedBy", fields: [moderatedById], references: [id])
  moderationNote String?

  // Structured free-text fields explicitly called for in the requirements
  howWeLive       String? // "So leben wir"
  whoWeAreLooking String? // "Wen wir suchen"

  // Standort: strukturiert für Filter/Anzeige, plus eine unspezifische Angabe
  // ("Großraum Allgäu") für Projekte ohne genaue Adresse. Land/Bundesland
  // werden im Formular aus der PLZ automatisch vorbelegt (Client-seitiges
  // Geocoding, siehe src/components/address-fields.tsx). `latitude`/
  // `longitude` sind normale Spalten (Ergebnis des Geocodings, mit Fallback
  // auf den Ort, falls die Straße nicht gefunden wird); `location` ist der
  // daraus abgeleitete PostGIS-Punkt für Umkreissuche — Prisma kann
  // Geometrie-Spalten nicht typisiert lesen/schreiben, dafür
  // $queryRaw/$executeRaw verwenden.
  country           String?
  state             String? // Bundesland
  postalCode        String?
  city              String? // Ort
  street            String?
  houseNumber       String?
  regionDescription String? // z. B. "Großraum Allgäu"
  latitude          Float?
  longitude         Float?
  location          Unsupported("geometry(Point, 4326)")?

  // Ansprechperson vor Ort (kann von createdBy abweichen, z. B. bei Organisationen)
  contactName  String?
  contactEmail String?
  contactPhone String?

  // Availability / temporary offers (Probewohnen, Retreat, Zwischennutzung)
  isTemporary  Boolean   @default(false)
  moveInDate   DateTime?
  minStayDays  Int?
  maxStayDays  Int?

  // Aktueller Suchzeitraum (Zeitraum, in dem aktiv gesucht wird)
  searchPeriodStart DateTime?
  searchPeriodEnd   DateTime?

  // Gruppengröße
  groupSizeCurrent Int? // aktuelle Gruppengröße
  groupSizePlanned Int? // geplante/Ziel-Gruppengröße
  freeSpots        Int?

  // Gewünschte Altersspanne der gesuchten Mitbewohner:innen
  desiredAgeMin Int?
  desiredAgeMax Int?

  // Kosten in EUR
  costOneTime Int? // einmalig, z. B. Genossenschaftsanteile/Kaution
  costMonthly Int? // monatlich

  categories        ListingCategoryAssignment[]
  attributeOptions  ListingAttributeOption[]
  media             Media[]
  events            Event[]
  reports           Report[]           @relation("ReportOnListing")
  contactRequests   ContactRequest[]
  appointments      Appointment[]
  managers          ListingManager[]
  views             ListingView[]

  @@index([status])
  @@index([organizationId])
  @@index([isDemo])
}

// --- Generic filter-attribute system (Projekt Typ, Projekt Status,
// Geschlechterverteilung, Organisationsform, Grundwerte, Wohnlage,
// Zielgruppe, ...) ----------------------------------------------------------
//
// One reusable group/option/assignment system instead of a bespoke table per
// filter category (which is what ListingCategory above already is for "Art
// des Projektinserates" — kept separate since it shipped first and changing
// it would be pure churn). New filter groups or values are just rows here,
// never a migration. `allowMultiple` is a UI hint (radio vs. checkboxes) —
// the underlying relation is many-to-many either way. `appliesTo` scopes a
// group to Listings or Events, since both now use this same system.
enum AttributeTargetType {
  LISTING
  EVENT
}

model AttributeGroup {
  id            String              @id @default(cuid())
  slug          String              @unique
  name          String
  nameEn        String?
  appliesTo     AttributeTargetType @default(LISTING)
  allowMultiple Boolean             @default(true)
  sortOrder     Int                 @default(0)
  createdAt     DateTime            @default(now())

  options AttributeOption[]
}

model AttributeOption {
  id        String   @id @default(cuid())
  groupId   String
  group     AttributeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  slug      String
  name      String
  nameEn    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  listings ListingAttributeOption[]
  events   EventAttributeOption[]

  @@unique([groupId, slug])
}

model ListingAttributeOption {
  listingId String
  listing   Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  optionId  String
  option    AttributeOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([listingId, optionId])
}

model EventAttributeOption {
  eventId  String
  event    Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  optionId String
  option   AttributeOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([eventId, optionId])
}

enum MediaType {
  PHOTO
  VIDEO
  DOCUMENT
  FLOORPLAN
}

// Belongs to exactly one of Listing or Event (enforced in application code,
// not the DB — both are optional so the same table/upload pipeline serves
// both galleries).
model Media {
  id            String    @id @default(cuid())
  listingId     String?
  listing       Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  eventId       String?
  event         Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type          MediaType
  // MinIO/S3 object key (display-sized image or uploaded video) — except
  // when isVideoLink is true, in which case this holds the embeddable
  // player URL (YouTube/Vimeo rewritten to their /embed/ form, any other
  // provider's URL as-is) instead of a MinIO key; there's no MinIO object
  // behind that row at all, so it's never passed through /api/media.
  storageKey    String
  thumbnailKey  String? // downscaled at upload time (or fetched from the provider's oEmbed for a video link); position 0's thumbnail is used as the listing's/event's list-view thumbnail
  caption       String?
  position      Int       @default(0)
  // True for a dedicated 360°/equirectangular panorama upload (separate
  // upload flow from regular photos, validated as ~2:1 aspect ratio at
  // upload time) — flags the gallery to show a 360° badge and render it
  // through the interactive panorama viewer instead of a plain <img>.
  isPanorama    Boolean   @default(false)
  // True for a video added via external link (YouTube/Vimeo/other) rather
  // than a file upload — type stays VIDEO either way (same gallery
  // tile/badge treatment), this flag only changes what storageKey means
  // (see above) and how the lightbox plays it back (<iframe> instead of a
  // local <video>). deleteListingMedia/deleteEventMedia must not call
  // deleteObject() on storageKey for these rows, since it isn't a MinIO key.
  isVideoLink   Boolean   @default(false)
  uploadedById  String
  uploadedBy    User      @relation("MediaUploadedBy", fields: [uploadedById], references: [id])
  createdAt     DateTime  @default(now())
}

// --- Calendar: events, info sessions, Besuchstage --------------------------

model Event {
  id        String        @id @default(cuid())
  status    ListingStatus @default(DRAFT)
  title     String
  description String?
  startAt   DateTime
  endAt     DateTime?
  addressText String? // zusätzliche Ortsangabe (z. B. Gebäude-/Raumname), kein Ersatz für die Adresse unten
  country     String?
  state       String? // Bundesland
  postalCode  String?
  city        String?
  street      String?
  houseNumber String?
  // `location` (PostGIS point) drives radius search via $queryRaw
  // (ST_DWithin); `latitude`/`longitude` are plain columns kept in sync with
  // it so the app can read/prefill coordinates with normal Prisma queries,
  // since Prisma can't read Unsupported columns directly.
  location    Unsupported("geometry(Point, 4326)")?
  latitude    Float?
  longitude   Float?

  websiteUrl           String?
  cost                 Int? // EUR, null = kostenlos/unbekannt
  maxParticipants      Int?
  registrationRequired Boolean @default(false)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  listingId      String?
  listing        Listing?      @relation(fields: [listingId], references: [id])

  createdById String
  createdBy   User   @relation("EventCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attributeOptions EventAttributeOption[]
  registrations    EventRegistration[]
  media            Media[]
  reports          Report[]               @relation("ReportOnEvent")
  views            EventView[]

  @@index([startAt])
  @@index([status])
}

// A message to the organizer, or a headcount signup ("X Teilnehmer
// anmelden") when the event requires registration. No accept/decline
// workflow (unlike ContactRequest) — the organizer just sees who's coming.
model EventRegistration {
  id               String   @id @default(cuid())
  eventId          String
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?    @relation("EventRegistrationSender", fields: [userId], references: [id])
  name             String
  email            String
  participantCount Int      @default(1)
  message          String?
  createdAt        DateTime @default(now())
  // Null until the organizer opens this event's /anmeldungen list (which
  // batch-marks every then-still-null row as viewed) — EventRegistration
  // otherwise has no status/read concept at all (see CLAUDE.md: "no accept/
  // decline workflow, the organizer just sees a list"), but the header nav
  // badge (see AccountMenu) needs *some* notion of "still open" to count,
  // mirroring ContactRequest.status === PENDING for that same badge.
  viewedAt         DateTime?
}

// --- Saved searches ---------------------------------------------------------

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  filters   Json
  createdAt DateTime @default(now())
}

// --- Contact & appointment requests (no chat, no matching) ----------------

enum ContactRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// A contact-form submission. Contact details of the listing owner are only
// revealed to the sender once status becomes ACCEPTED.
model ContactRequest {
  id          String                @id @default(cuid())
  listingId   String
  listing     Listing               @relation(fields: [listingId], references: [id], onDelete: Cascade)
  senderUserId String?
  senderUser   User?                @relation("ContactRequestSender", fields: [senderUserId], references: [id])
  senderName  String
  senderEmail String
  message     String
  status      ContactRequestStatus  @default(PENDING)
  createdAt   DateTime              @default(now())
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
}

// Besichtigungstermin / visiting-day scheduling between a searcher and a listing.
model Appointment {
  id                String            @id @default(cuid())
  listingId         String
  listing           Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  hostUserId        String
  hostUser          User              @relation("AppointmentHost", fields: [hostUserId], references: [id])
  requestedByUserId String?
  requestedByUser   User?             @relation("AppointmentRequestedBy", fields: [requestedByUserId], references: [id])
  requesterName     String?
  requesterEmail    String?
  proposedAt        DateTime
  message           String?
  status            AppointmentStatus @default(REQUESTED)
  createdAt         DateTime          @default(now())
}

// --- Trust & safety ---------------------------------------------------------

enum ReportTargetType {
  LISTING
  EVENT
  ORGANIZATION
  USER
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTIONED
}

model Report {
  id             String           @id @default(cuid())
  targetType     ReportTargetType
  listingId      String?
  listing        Listing?         @relation("ReportOnListing", fields: [listingId], references: [id])
  eventId        String?
  event          Event?           @relation("ReportOnEvent", fields: [eventId], references: [id])
  reporterId     String?
  reporter       User?            @relation("ReportReporter", fields: [reporterId], references: [id])
  reporterIp     String? // fallback for guest reports / fake-listing IP blocking
  reason         String
  message        String?
  status         ReportStatus     @default(OPEN)
  reviewedById   String?
  reviewedBy     User?            @relation("ReportReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())
}
